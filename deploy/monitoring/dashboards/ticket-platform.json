        {
          "expr": "max by (workflow) (ticket_workflow_oldest_seconds)",
          "legendFormat": "{{application}} {{instance}} {{workflow}} {{outcome}} {{alertname}}",
          "refId": "A"
        }
      ],
      "id": 6,
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "type": "timeseries",
