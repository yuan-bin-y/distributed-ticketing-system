        "uid": "ticket-prometheus",
        "type": "prometheus"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "w": 24,
        "y": 40,
        "h": 8,
        "x": 0
      },
      "targets": [
        {
          "legendFormat": "{{queue}}",
          "refId": "A",
          "expr": "max by (queue) (ticket_mq_queue_messages)"
