{
  "version": 1,
  "uid": "ticket-platform-overview",
  "refresh": "5s",
  "title": "Ticket Platform Overview",
  "panels": [
    {
      "title": "服务健康",
      "targets": [
        {
          "expr": "up{job=\"ticket-services\"}",
          "legendFormat": "{{application}} {{instance}} {{workflow}} {{outcome}} {{alertname}}",
          "refId": "A"
        }
      ],
      "id": 1,
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "type": "timeseries",
      "fieldConfig": {
        "overrides": [],
        "defaults": {}
      },
      "gridPos": {
        "w": 12,
        "y": 0.0,
        "x": 0,
        "h": 8
      }
    },
    {
      "title": "HTTP请求率",
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}} {{instance}} {{workflow}} {{outcome}} {{alertname}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "type": "timeseries",
      "fieldConfig": {
        "overrides": [],
        "defaults": {}
      },
      "gridPos": {
        "w": 12,
        "y": 0.0,
        "x": 12,
        "h": 8
      }
    },
    {
      "title": "HTTP P95延迟（秒）",
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le,application) (rate(http_server_requests_seconds_bucket[2m])))",
          "legendFormat": "{{application}} {{instance}} {{workflow}} {{outcome}} {{alertname}}",
          "refId": "A"
        }
      ],
      "id": 3,
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "type": "timeseries",
      "fieldConfig": {
        "overrides": [],
        "defaults": {}
      },
      "gridPos": {
        "w": 12,
        "y": 8.0,
        "x": 0,
        "h": 8
      }
    },
    {
      "title": "HTTP 5xx请求率",
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "{{application}} {{instance}} {{workflow}} {{outcome}} {{alertname}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "type": "timeseries",
      "fieldConfig": {
        "overrides": [],
        "defaults": {}
      },
      "gridPos": {
        "w": 12,
        "y": 8.0,
        "x": 12,
        "h": 8
      }
    },
    {
      "title": "持久化任务数量",
      "targets": [
        {
          "expr": "max by (workflow) (ticket_workflow_pending)",
          "legendFormat": "{{application}} {{instance}} {{workflow}} {{outcome}} {{alertname}}",
          "refId": "A"
        }
      ],
      "id": 5,
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "type": "timeseries",
      "fieldConfig": {
        "overrides": [],
        "defaults": {}
      },
      "gridPos": {
        "w": 12,
        "y": 16.0,
        "x": 0,
        "h": 8
      }
    },
    {
      "title": "最旧积压时长（秒）",
