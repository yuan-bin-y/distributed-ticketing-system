# Learning walkthroughs, acceptance reports and ad hoc verification stay local.
# Publish only project usage/deployment and API documentation below.
# Add a !/docs/<name> entry when a new document is ready for other readers.
/notes/
/deploy/verify/
/deploy/docker/verify*.ps1
/docs/*
!/docs/apifox/
!/docs/docker-deployment.md
